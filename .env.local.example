# 独立本地稳定环境配置。此文件不含凭据；./local init-config 会生成配套 .env.local.secrets。
CHATBI_LOCAL_HTTP_PORT=8080
CHATBI_LOCAL_MODEL_DIR=.model-cache/bge-m3-5617a9f61b02

POSTGRES_DB=chatbi_mvp
POSTGRES_MIGRATOR_USER=chatbi_migrator

# 填写你现有外部 LLM 服务的 API Key；不要从开发 .env 自动复制。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30

# Stable Trace export is opt-in. Keep the endpoint in this mode-600 file;
# authentication headers are stored in the mode-600 .env.local.secrets file.
CHATBI_OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
CHATBI_OTLP_TIMEOUT_SECONDS=5
