#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
CONFIG_FILE="$ROOT/.env.local"
SECRET_FILE="$ROOT/.env.local.secrets"
RELEASE_FILE="$ROOT/.local/release.env"
RELEASE_DIR="$ROOT/.local/releases"
PROJECT_NAME="chatbi-stable"
source "$ROOT/scripts/local_port.sh"
source "$ROOT/scripts/local_build_cache.sh"
source "$ROOT/scripts/local_deployment_state.sh"
source "$ROOT/scripts/local_backup.sh"
source "$ROOT/scripts/local_runtime_binding.sh"

# Compose reads only the dedicated stable files; developer-shell variables must not
# override them or leak development credentials into this independent project.
for key in \
    COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME \
    CHATBI_API_IMAGE CHATBI_DATABASE_IMAGE CHATBI_SOURCE_COMMIT CHATBI_OPERATIONS_IMAGE \
    CHATBI_LOCAL_HTTP_PORT CHATBI_LOCAL_MODEL_DIR CHATBI_ADMIN_SECRET_KEY \
    CHATBI_LOCAL_UID CHATBI_LOCAL_GID CHATBI_LOCAL_SECCOMP_PROFILE \
    CHATBI_BOUND_POSTGRES_VOLUME CHATBI_BOUND_QDRANT_VOLUME CHATBI_BOUND_RAG_DIR \
    CHATBI_BOUND_OPERATIONS_API_DIR CHATBI_BOUND_OPERATIONS_API_RELATIVE \
    CHATBI_BOUND_DATABASE_IMAGE CHATBI_BOUND_DATABASE_IMAGE_ID CHATBI_BOUND_STATE_DIR \
    POSTGRES_DB POSTGRES_MIGRATOR_USER POSTGRES_MIGRATOR_PASSWORD \
    POSTGRES_APP_PASSWORD POSTGRES_CONTROL_APP_PASSWORD \
    QDRANT_API_KEY LLM_API_KEY LLM_BASE_URL LLM_MODEL \
    LLM_TEMPERATURE LLM_MAX_TOKENS LLM_TIMEOUT_SECONDS
do
    unset "$key" || true
done

CHATBI_LOCAL_UID="$(id -u)"
CHATBI_LOCAL_GID="$(id -g)"
CHATBI_LOCAL_SECCOMP_PROFILE="$ROOT/docker/third-party/playwright-seccomp-profile.json"
RESTORE_JOURNAL_EXIT_ID=''
RESTORE_JOURNAL_EXIT_PHASE=''
export CHATBI_LOCAL_UID CHATBI_LOCAL_GID CHATBI_LOCAL_SECCOMP_PROFILE

fail() {
    printf '错误：%s\n' "$1" >&2
    exit 1
}

acquire_operation_lock() {
    case "${1:-help}" in
        init-config|build|build-operations|init-backup|backup|infra|migrate|create-admin|prepare-model|build-rag|up|down|upgrade|rollback|restore|restore-activate|restore-recover)
            command -v flock >/dev/null 2>&1 || fail '稳定环境写操作需要 util-linux 提供的 flock。'
            mkdir -p "$ROOT/.local" || fail '无法创建稳定环境本地状态目录。'
            [[ ! -L "$ROOT/.local" && ! -L "$ROOT/.local/operation.lock" ]] \
                || fail '稳定环境操作锁路径存在符号链接；拒绝写入。'
            if [[ -e "$ROOT/.local/operation.lock" ]]; then
                [[ -f "$ROOT/.local/operation.lock" && "$(stat -c '%u' "$ROOT/.local/operation.lock")" == "$(id -u)" ]] \
                    || fail '稳定环境操作锁归属未确认。'
            fi
            check_operations_root
            local lock_fd
            exec {lock_fd}>>"$ROOT/.local/operation.lock" \
                || fail '无法打开稳定环境操作锁。'
            flock -n "$lock_fd" \
                || fail '另一个稳定环境写操作正在执行；等待其结束后重试。'
            ;;
    esac
}

usage() {
    cat <<'EOF'
ChatBI 本地稳定环境（与开发 Compose、开发 .env、开发数据卷隔离）

用法：./local <命令>

  init-config    创建独立配置并生成一次性数据库、管理员和 Qdrant 随机密钥
  build          从当前 clean commit 构建带身份的 API / PostgreSQL 固定版本镜像
  build-operations  从clean commit构建固定age/PG16备份工具
  init-backup    显式初始化备份密钥；重复执行不覆盖
  backup         备份实际运行版本，完整解密校验后登记
  backup-list    只读列出已登记加密副本
  infra          启动稳定 PostgreSQL / Qdrant 并等待基础合成数据初始化
  migrate        显式安装应用库、RBAC 和 checkpoint Schema
  create-admin   交互创建首个管理员，密码不回显
  prepare-model  准备固定 revision BGE-M3 模型缓存
  build-rag      在独立稳定 Qdrant / RAG 目录构建发布索引
  up             检查镜像、数据库、模型和索引后后台启动 API
  upgrade <SHA>  兼容检查后迁移并启动指定完整 commit
  rollback <SHA> 兼容检查后回滚到指定完整 commit，不执行 migration
  restore <ID>   在隔离项目完整恢复并交互核验登录与历史
  restore-activate <恢复ID> 记录 journal 后显式切换已核验候选
  restore-recover <恢复ID> --previous|--candidate 显式选择中断后的资源
  down           停止稳定环境服务并保留全部数据和资产
  status         查看稳定环境服务状态与本机地址
  logs [服务]    查看 api、postgres、qdrant 或 backup 安全日志

配置后需在 .env.local 中填写外部 LLM_API_KEY。此入口不会读取或复制开发 .env。
EOF
}

require_docker() {
    command -v docker >/dev/null 2>&1 || fail '需要 WSL/Linux 中可用的 Docker Engine。'
    docker compose version >/dev/null 2>&1 || fail '需要 Docker Compose v2。'
}

read_config_value() {
    local wanted="$1"
    awk -F= -v wanted="$wanted" '$1 == wanted { sub(/^[^=]*=/, ""); value = $0 } END { print value }' "$CONFIG_FILE"
}

require_config() {
    [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || fail '缺少 .env.local；先运行 ./local init-config。'
    [[ -f "$SECRET_FILE" && ! -L "$SECRET_FILE" ]] || fail '缺少 .env.local.secrets；运行 ./local init-config，不会覆盖现有配置。'
    local mode
    for file in "$CONFIG_FILE" "$SECRET_FILE"; do
        [[ "$(stat -c '%u' "$file")" == "$(id -u)" ]] || fail '配置文件归属未确认。'
        mode="$(stat -c '%a' "$file" 2>/dev/null)" || fail "无法检查配置文件权限：${file##*/}"
        if (( (8#$mode & 077) != 0 )); then
            fail "${file##*/} 权限过宽；请执行 chmod 600 '${file##*/}'。"
        fi
    done
    [[ -s "$CONFIG_FILE" && -s "$SECRET_FILE" ]] || fail '独立本地配置文件为空。'
}

require_release() {
    [[ -f "$RELEASE_FILE" && ! -L "$RELEASE_FILE" ]] \
        || fail '尚无安全的本地固定版本记录；先运行 ./local build。'
    [[ "$(stat -c '%u' "$RELEASE_FILE")" == "$(id -u)" ]] \
        || fail '本地发布记录归属未确认。'
    local release_mode
    release_mode="$(stat -c '%a' "$RELEASE_FILE" 2>/dev/null)" \
        || fail '无法检查本地发布记录权限。'
    (( (8#$release_mode & 077) == 0 )) \
        || fail '本地发布记录权限过宽。'
    CHATBI_SOURCE_COMMIT=''
    CHATBI_API_IMAGE=''
    CHATBI_API_IMAGE_ID=''
    CHATBI_DATABASE_IMAGE=''
    CHATBI_DATABASE_IMAGE_ID=''
    local key value
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        case "$key" in
            CHATBI_SOURCE_COMMIT|CHATBI_API_IMAGE|CHATBI_API_IMAGE_ID|CHATBI_DATABASE_IMAGE|CHATBI_DATABASE_IMAGE_ID)
                printf -v "$key" '%s' "$value"
                ;;
        esac
    done < "$RELEASE_FILE"
    [[ "$CHATBI_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail '本地发布记录中的 source commit 无效。'
    [[ "$CHATBI_API_IMAGE" == chatbi-local-api:* ]] || fail '本地发布记录中的 API 镜像无效。'
    [[ "$CHATBI_DATABASE_IMAGE" == chatbi-local-postgres:* ]] || fail '本地发布记录中的 PostgreSQL 镜像无效。'
    [[ "$CHATBI_API_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] || fail '本地发布记录中的 API image ID 无效。'
    [[ "$CHATBI_DATABASE_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] || fail '本地发布记录中的 PostgreSQL image ID 无效。'
    export CHATBI_SOURCE_COMMIT CHATBI_API_IMAGE CHATBI_DATABASE_IMAGE
}

compose() {
    local -a options=(
        --project-name "$PROJECT_NAME"
        --profile tools
        --file "$ROOT/docker-compose.local.yml"
        --env-file "$CONFIG_FILE"
        --env-file "$SECRET_FILE"
    )
    if [[ -f "$RELEASE_FILE" ]]; then
        options+=(--env-file "$RELEASE_FILE")
    fi
    docker compose "${options[@]}" "$@"
}

stable_container_ids() {
    local service="$1"
    docker ps --all --quiet \
        --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --filter "label=com.docker.compose.service=$service"
}

stop_stable_services() {
    local service container state found=false
    for service in backup api postgres qdrant; do
        while IFS= read -r container; do
            [[ -n "$container" ]] || continue
            found=true
            state="$(docker inspect --format '{{.State.Running}}' "$container")"
            if [[ "$state" == true ]]; then
                docker stop "$container" >/dev/null
            fi
        done < <(stable_container_ids "$service")
    done
    if [[ "$found" == false ]]; then
        printf '稳定环境尚无已创建服务。\n'
    else
        printf '稳定环境已停止；PostgreSQL、Qdrant、RAG 与模型数据均已保留。\n'
    fi
}

show_stable_status() {
    local source_commit='未构建' port=8080
    printf '活动资源绑定: %s\n' "$CHATBI_BOUND_ENVIRONMENT_ID"
    if [[ -f "$CONFIG_FILE" ]]; then
        port="$(read_config_value CHATBI_LOCAL_HTTP_PORT)"
        [[ -n "$port" ]] || port=8080
    fi
    if [[ -f "$RELEASE_FILE" ]]; then
        while IFS='=' read -r key value || [[ -n "$key" ]]; do
            if [[ "$key" == CHATBI_SOURCE_COMMIT && "$value" =~ ^[0-9a-f]{40}$ ]]; then
                source_commit="$value"
                break
            fi
        done < "$RELEASE_FILE"
    fi
    printf '最新构建 source commit: %s\n本机地址: http://127.0.0.1:%s/\n' "$source_commit" "$port"
    if [[ -f "$ROOT/.local/deployment-state.json" ]]; then
        printf '本机部署状态记录：'
        cat "$ROOT/.local/deployment-state.json"
    fi
    docker ps --all \
        --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --format '{{.Label "com.docker.compose.service"}} | {{.Status}} | {{.Ports}}'
    if [[ -d "$ROOT/.local/operations" ]]; then
        python3 "$ROOT/scripts/local_restore_state.py" journal-show --root "$ROOT/.local" \
            | python3 -c 'import json,sys; result=json.load(sys.stdin).get("result"); print("恢复切换: 无未完成日志" if not result else "恢复切换: id=%s state=%s phase=%s" % (result["id"],result["state"],result["phase"]))' \
            || printf '恢复切换: 日志状态无法核验。\n'
        python3 "$ROOT/scripts/local_restore_state.py" list-records --root "$ROOT/.local" \
            | python3 -c 'import json,sys; items=json.load(sys.stdin).get("result",[]); [print("恢复候选: %s status=%s" % (item["id"],item["status"])) for item in items]' \
            || printf '恢复候选: 本机登记无法核验。\n'
    fi
    local container
    container="$(stable_container_ids api | head -1)"
    printf '运行就绪证据：'
    if [[ -n "$container" ]] && docker exec "$container" python -m scripts.local_operations_status 2>/dev/null; then
        :
    else
        printf '未确认（API未运行或当前版本尚无运行状态入口）。\n'
    fi
}

show_stable_logs() {
    local -a services=(api postgres qdrant backup)
    if (( $# > 0 )); then
        (( $# == 1 )) && [[ "$1" =~ ^(api|postgres|qdrant|backup)$ ]] \
            || fail '日志服务仅支持 api、postgres、qdrant、backup；不支持额外过滤参数。'
        services=("$1")
    fi
    local service container found
    for service in "${services[@]}"; do
        found=false
        while IFS= read -r container; do
            [[ -n "$container" ]] || continue
            found=true
            printf '\n===== %s =====\n' "$service"
            docker logs --tail=200 "$container"
        done < <(stable_container_ids "$service")
        if [[ "$found" == false ]]; then
            printf '%s: 尚无容器。\n' "$service"
        fi
    done
}

restore_state_cli() {
    python3 "$ROOT/scripts/local_restore_state.py" "$@" --root "$ROOT/.local"
}

restore_tool() {
    compose run --rm -T --no-deps restore-tool "$@"
}

run_restore_prepare_locked() {
    local backup_id="$1" restore_id="$2"
    docker run --rm --user "$CHATBI_LOCAL_UID:$CHATBI_LOCAL_GID" \
        --mount "type=bind,source=$ROOT/.local/operations,target=/state/operations" \
        --mount "type=bind,source=$ROOT/.local/backups,target=/state/backups,readonly" \
        --mount "type=bind,source=$ROOT/.local/backup-keys,target=/state/backup-keys,readonly" \
        --mount "type=bind,source=$ROOT/.local/operation.lock,target=/state/operation.lock" \
        --entrypoint python3 "$CHATBI_OPERATIONS_IMAGE" -m scripts.local_restore prepare \
        --root /state --backup-id "$backup_id" --restore-id "$restore_id" --host-locked
}

candidate_project_container_ids() {
    local project="$1"
    docker ps --all --quiet --filter "label=com.docker.compose.project=$project"
}

stop_candidate_project() {
    local project="$1" container running
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        if [[ "$running" == true ]]; then
            docker stop "$container" >/dev/null || fail '无法确认隔离恢复项目已停止；资源保留。'
        fi
    done < <(candidate_project_container_ids "$project")
}

cleanup_candidate_project() {
    local project="$1" container running
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        [[ "$running" == true ]] && docker stop "$container" >/dev/null 2>&1 || true
    done < <(candidate_project_container_ids "$project")
}

cleanup_candidate_service() {
    local project="$1" service="$2" container
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        [[ "$(docker inspect --format '{{.Config.Labels "com.docker.compose.service"}}' "$container" 2>/dev/null || true)" == "$service" ]] || continue
        docker stop "$container" >/dev/null 2>&1 || true
    done < <(candidate_project_container_ids "$project")
}

stop_candidate_service() {
    local project="$1" service="$2" container running
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        [[ "$(docker inspect --format '{{.Config.Labels "com.docker.compose.service"}}' "$container" 2>/dev/null || true)" == "$service" ]] || continue
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        if [[ "$running" == true ]]; then
            docker stop "$container" >/dev/null || fail "无法确认隔离候选 ${service} 已停止。"
        fi
    done < <(candidate_project_container_ids "$project")
}

require_candidate_project_stopped() {
    local project="$1" container running
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        [[ "$running" != true ]] || fail '隔离恢复项目仍有运行容器；拒绝切换。'
    done < <(candidate_project_container_ids "$project")
}

require_restore_volume_labels() {
    local restore_id="$1" kind="$2" name="$3"
    [[ "$(docker volume inspect --format '{{.Name}}' "$name" 2>/dev/null || true)" == "$name" ]] \
        || fail '隔离恢复卷不存在；拒绝自动新建空卷替代恢复数据。'
    [[ "$(docker volume inspect --format '{{index .Labels "com.chatbi.restore-id"}}' "$name" 2>/dev/null || true)" == "$restore_id" \
        && "$(docker volume inspect --format '{{index .Labels "com.chatbi.product"}}' "$name" 2>/dev/null || true)" == chatbi-engine \
        && "$(docker volume inspect --format '{{index .Labels "com.chatbi.resource-kind"}}' "$name" 2>/dev/null || true)" == "$kind" ]] \
        || fail '隔离恢复卷标签与登记记录不符；拒绝复用。'
}

create_restore_volumes() {
    local restore_id="$1" postgres="$2" qdrant="$3"
    if docker volume inspect "$postgres" >/dev/null 2>&1 || docker volume inspect "$qdrant" >/dev/null 2>&1; then
        fail '本次恢复卷名已存在；不复用或覆盖未知资源。'
    fi
    docker volume create --label "com.chatbi.restore-id=$restore_id" \
        --label com.chatbi.product=chatbi-engine --label com.chatbi.resource-kind=postgres "$postgres" >/dev/null \
        || fail '无法创建隔离 PostgreSQL 卷；保留已登记的恢复状态。'
    docker volume create --label "com.chatbi.restore-id=$restore_id" \
        --label com.chatbi.product=chatbi-engine --label com.chatbi.resource-kind=qdrant "$qdrant" >/dev/null \
        || fail '无法创建隔离 Qdrant 卷；保留已登记的恢复状态。'
    require_restore_volume_labels "$restore_id" postgres "$postgres"
    require_restore_volume_labels "$restore_id" qdrant "$qdrant"
}

apply_restore_context() {
    local restore_id="$1" state_dir="$ROOT/.local/operations/restores/$1"
    local parsed
    parsed="$(python3 -c 'import sys; from scripts.local_restore_state import load_record; from scripts.local_runtime_binding import binding_environment; print(binding_environment(load_record(sys.argv[1], sys.argv[2])["binding"]), end="")' \
        "$ROOT/.local/operations" "$restore_id")" || fail '恢复登记记录无效；拒绝继续。'
    apply_binding_environment "$parsed"
    CHATBI_BOUND_STATE_DIR="$state_dir/state"
    export CHATBI_BOUND_STATE_DIR
}

require_restore_model_cache() {
    local model_path
    model_path="$(read_config_value CHATBI_LOCAL_MODEL_DIR)"
    if [[ "$model_path" != /* ]]; then model_path="$ROOT/$model_path"; fi
    model_path="$(realpath -m -- "$model_path")"
    [[ "$model_path" == "$(realpath -m -- "$ROOT/.model-cache/bge-m3-5617a9f61b02")" \
        && -f "$model_path/config.json" ]] \
        || fail '恢复要求复用已准备的固定 BGE-M3 模型缓存；未修改其他模型目录。'
}

verify_candidate_release_assets() {
    verify_release_images
    local expected actual expected_digest
    local -a identity
    expected="$(python3 -c 'import sys; from scripts.local_restore_state import load_record; r=load_record(sys.argv[1],sys.argv[2]); print("\n".join((r["source_commit"],r["api_image"],r["api_image_id"],r["database_image"],r["database_image_id"],r["compatibility_sha256"])))' \
        "$ROOT/.local/operations" "$CHATBI_BOUND_ENVIRONMENT_ID")" \
        || fail '恢复候选登记记录无法核验。'
    mapfile -t identity <<< "$expected"
    (( ${#identity[@]} == 6 )) \
        || fail '恢复候选登记身份格式错误。'
    [[ "$CHATBI_SOURCE_COMMIT" == "${identity[0]}" \
        && "$CHATBI_API_IMAGE" == "${identity[1]}" \
        && "$CHATBI_API_IMAGE_ID" == "${identity[2]}" \
        && "$CHATBI_DATABASE_IMAGE" == "${identity[3]}" \
        && "$CHATBI_BOUND_DATABASE_IMAGE" == "${identity[3]}" \
        && "$CHATBI_BOUND_DATABASE_IMAGE_ID" == "${identity[4]}" ]] \
        || fail '恢复候选发布记录与资源登记不一致。'
    expected_digest="$(python3 -c 'import hashlib,sys; from scripts.local_backup import secure_file; print(hashlib.sha256(secure_file(sys.argv[1])).hexdigest())' \
        "$ROOT/.local/operations/restores/$CHATBI_BOUND_ENVIRONMENT_ID/compatibility.json")" \
        || fail '恢复兼容性声明权限或内容无效。'
    [[ "$expected_digest" == "${identity[5]}" ]] \
        || fail '恢复兼容性声明与 verified 登记不一致。'
    expected="$(cat "$ROOT/.local/operations/restores/$CHATBI_BOUND_ENVIRONMENT_ID/compatibility.json")" \
        || fail '恢复兼容性声明缺失。'
    actual="$(docker run --rm --entrypoint /bin/cat "$CHATBI_API_IMAGE" /opt/chatbi-compatibility.json 2>/dev/null)" \
        || fail '候选 API 镜像无法读取兼容性声明。'
    [[ "$actual" == "$expected" ]] \
        || fail '备份兼容性声明与固定 API 镜像不一致；拒绝恢复。'
}

capture_previous_runtime() {
    local service container running total active fallback identity source_commit actual_id
    local -a containers
    for service in api postgres; do
        mapfile -t containers < <(stable_container_ids "$service")
        (( ${#containers[@]} > 0 )) || fail "原 stable ${service} 容器缺失；无法登记 exact previous runtime。"
        total=0
        active=''
        fallback=''
        for container in "${containers[@]}"; do
            [[ -n "$container" ]] || continue
            total=$((total + 1))
            [[ -n "$fallback" ]] || fallback="$container"
            running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
            if [[ "$running" == true ]]; then
                [[ -z "$active" ]] || fail "原 stable ${service} 有多个运行容器；拒绝模糊 previous。"
                active="$container"
            fi
        done
        if [[ "$service" == api ]]; then
            [[ -n "$active" ]] && container="$active" || { (( total == 1 )) || fail '原 stable API 容器身份不唯一。'; container="$fallback"; }
            identity="$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}|{{.Config.Image}}|{{.Image}}' "$container")"
            IFS='|' read -r source_commit PREVIOUS_RUNTIME_API_IMAGE PREVIOUS_RUNTIME_API_IMAGE_ID <<< "$identity"
            [[ "$source_commit" =~ ^[0-9a-f]{40}$ \
                && "$PREVIOUS_RUNTIME_API_IMAGE" =~ ^chatbi-local-api:[A-Za-z0-9_.-]+$ \
                && "$PREVIOUS_RUNTIME_API_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
                || fail '原 stable API runtime identity 无效。'
            PREVIOUS_RUNTIME_RELEASE_FILE="$RELEASE_DIR/$source_commit.env"
            [[ -f "$PREVIOUS_RUNTIME_RELEASE_FILE" && ! -L "$PREVIOUS_RUNTIME_RELEASE_FILE" ]] \
                || fail '原 stable API 的不可变 release 文件缺失。'
            PREVIOUS_RUNTIME_RELEASE_REF="${PREVIOUS_RUNTIME_RELEASE_FILE#"$ROOT/"}"
            local RELEASE_FILE="$PREVIOUS_RUNTIME_RELEASE_FILE"
            local CHATBI_SOURCE_COMMIT='' CHATBI_API_IMAGE='' CHATBI_API_IMAGE_ID='' CHATBI_DATABASE_IMAGE='' CHATBI_DATABASE_IMAGE_ID=''
            require_release
            [[ "$CHATBI_SOURCE_COMMIT" == "$source_commit" \
                && "$CHATBI_API_IMAGE" == "$PREVIOUS_RUNTIME_API_IMAGE" \
                && "$CHATBI_API_IMAGE_ID" == "$PREVIOUS_RUNTIME_API_IMAGE_ID" ]] \
                || fail '原 stable API 与其不可变 release 文件不匹配。'
            actual_id="$(docker image inspect --format '{{.Id}}' "$PREVIOUS_RUNTIME_API_IMAGE" 2>/dev/null || true)"
            [[ "$actual_id" == "$PREVIOUS_RUNTIME_API_IMAGE_ID" ]] \
                || fail '原 stable API 镜像 tag 与运行 image ID 不匹配。'
        else
            [[ -n "$active" ]] && container="$active" || { (( total == 1 )) || fail '原 stable PostgreSQL 容器身份不唯一。'; container="$fallback"; }
            identity="$(docker inspect --format '{{.Config.Image}}|{{.Image}}' "$container")"
            IFS='|' read -r PREVIOUS_RUNTIME_DATABASE_IMAGE PREVIOUS_RUNTIME_DATABASE_IMAGE_ID <<< "$identity"
            [[ "$PREVIOUS_RUNTIME_DATABASE_IMAGE" =~ ^chatbi-local-postgres:[A-Za-z0-9_.-]+$ \
                && "$PREVIOUS_RUNTIME_DATABASE_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
                || fail '原 stable PostgreSQL runtime identity 无效。'
            actual_id="$(docker image inspect --format '{{.Id}}' "$PREVIOUS_RUNTIME_DATABASE_IMAGE" 2>/dev/null || true)"
            [[ "$actual_id" == "$PREVIOUS_RUNTIME_DATABASE_IMAGE_ID" ]] \
                || fail '原 stable PostgreSQL image tag 与运行 image ID 不匹配。'
        fi
    done
}

restore_project_compose() {
    local restore_id="$CHATBI_BOUND_ENVIRONMENT_ID"
    local PROJECT_NAME="chatbi-restore-$restore_id"
    compose "$@"
}

wait_for_restore_postgres() {
    local container state attempt database user
    database="$(read_config_value POSTGRES_DB)"
    user="$(read_config_value POSTGRES_MIGRATOR_USER)"
    [[ "$database" == chatbi_mvp && "$user" == chatbi_migrator ]] \
        || fail '恢复目标数据库或管理角色不符合固定 Contract。'
    for attempt in $(seq 1 90); do
        container="$(restore_project_compose ps -q postgres)"
        if [[ -n "$container" ]]; then
            state="$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null || true)"
            [[ "$state" != exited && "$state" != dead ]] || return 1
            if docker exec "$container" pg_isready --username "$user" --dbname "$database" >/dev/null 2>&1; then
                return 0
            fi
        fi
        sleep 2
    done
    return 1
}

wait_for_restore_api() {
    local container health attempt port
    port="$CHATBI_LOCAL_HTTP_PORT"
    for attempt in $(seq 1 90); do
        container="$(restore_project_compose ps -q api)"
        if [[ -n "$container" ]]; then
            health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)"
            if [[ "$health" == healthy ]] && local_loopback_http_health_ok "$port"; then
                [[ "$(docker port "$container" 8000/tcp 2>/dev/null || true)" == "127.0.0.1:$port" ]] || return 1
                return 0
            fi
            [[ "$health" != unhealthy && "$health" != exited && "$health" != dead ]] \
                || return 1
        fi
        sleep 2
    done
    return 1
}

write_restore_verification() {
    local login_json="$1" duration="$2" path="$ROOT/.local/operations/restores/$CHATBI_BOUND_ENVIRONMENT_ID/verification.json"
    printf '%s' "$login_json" | python3 -c 'import json,os,sys; auth=json.load(sys.stdin); seconds=int(sys.argv[1]); assert auth == {"history": True, "login": True}; value={"readiness": True, "login": auth["login"], "history": auth["history"], "index_ready": True, "duration_seconds": seconds}; fd=os.open(sys.argv[2], os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW, 0o600); stream=os.fdopen(fd,"w"); json.dump(value,stream,sort_keys=True); stream.flush(); os.fsync(stream.fileno())' \
        "$duration" "$path" || fail '恢复核验结果无效；候选保持未验证。'
}

restore_backup() {
    local backup_id="$1" restore_id project state_dir port model_path prepared login_result duration credentials
    [[ "$backup_id" =~ ^[0-9a-f]{32}$ ]] || fail 'restore 只接受已登记备份 ID。'
    require_docker
    prepare_operations_directories
    require_operations_image
    [[ -x "$ROOT/.venv/bin/python" ]] || fail '隔离登录核验需要仓库虚拟环境中的 Argon2 工具；未创建恢复资源。'
    restore_id="$(openssl rand -hex 16)" || fail '无法生成隔离恢复 ID。'
    local RESTORE_STARTED="$SECONDS"
    local CONFIG_FILE="$ROOT/.local/operations/restores/$restore_id/config.env"
    local SECRET_FILE="$ROOT/.local/operations/restores/$restore_id/secrets.env"
    local RELEASE_FILE="$ROOT/.local/operations/restores/$restore_id/release.env"
    local PROJECT_NAME="chatbi-restore-$restore_id"
    local CHATBI_BOUND_ENVIRONMENT_ID="$restore_id"
    local CHATBI_BOUND_POSTGRES_VOLUME="chatbi_restore_${restore_id}_postgres_data"
    local CHATBI_BOUND_QDRANT_VOLUME="chatbi_restore_${restore_id}_qdrant_data"
    local CHATBI_BOUND_RAG_DIR="$ROOT/.local/operations/restores/$restore_id/rag"
    local CHATBI_BOUND_OPERATIONS_API_DIR="$ROOT/.local/operations/restores/$restore_id/api"
    local CHATBI_BOUND_OPERATIONS_API_RELATIVE="restores/$restore_id/api"
    local CHATBI_BOUND_DATABASE_IMAGE='' CHATBI_BOUND_DATABASE_IMAGE_ID=''
    local CHATBI_BOUND_STATE_DIR="$ROOT/.local/operations/restores/$restore_id/state"
    local CHATBI_LOCAL_HTTP_PORT=''
    export CHATBI_BOUND_ENVIRONMENT_ID CHATBI_BOUND_POSTGRES_VOLUME CHATBI_BOUND_QDRANT_VOLUME
    export CHATBI_BOUND_RAG_DIR CHATBI_BOUND_OPERATIONS_API_DIR CHATBI_BOUND_OPERATIONS_API_RELATIVE
    export CHATBI_BOUND_DATABASE_IMAGE CHATBI_BOUND_DATABASE_IMAGE_ID CHATBI_BOUND_STATE_DIR CHATBI_LOCAL_HTTP_PORT

    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')" \
        || fail '无法分配隔离候选回环端口。'
    CHATBI_LOCAL_HTTP_PORT="$port"
    local candidate_context_active=false temp_identity_active=false restore_prepared=false
    restore_failure_cleanup() {
        local result=$?
        trap - EXIT
        if [[ "$temp_identity_active" == true ]]; then
            cleanup_candidate_service "$PROJECT_NAME" api
            restore_tool temp-identity --identity-action cleanup --root /state \
                --restore-id "$restore_id" --host-locked >/dev/null 2>&1 \
                || printf '临时核验账号未能清理；隔离数据库保留且候选不可激活。\n' >&2
            temp_identity_active=false
            credentials=''
        fi
        if [[ "$candidate_context_active" == true && $result -ne 0 ]]; then
            cleanup_candidate_project "$PROJECT_NAME"
            printf '未验证候选已停止；恢复卷和登记记录保留在本机供检查。\n' >&2
        fi
        if [[ "$restore_prepared" == true && $result -ne 0 ]]; then
            restore_tool clear-payload --root /state --restore-id "$restore_id" --host-locked \
                >/dev/null 2>&1 \
                || printf '恢复失败后的明文暂存未能清理；请检查隔离恢复目录归属。\n' >&2
            restore_prepared=false
        fi
    }
    trap restore_failure_cleanup EXIT

    # prepare creates only a private candidate record and encrypted-copy staging.
    prepared="$(run_restore_prepare_locked "$backup_id" "$restore_id")" \
        || fail '备份解密、清单、角色或固定来源核验失败；未创建数据库卷。'
    [[ "$prepared" == *"\"status\": \"success\""* || "$prepared" == *"\"status\":\"success\""* ]] \
        || fail '隔离恢复登记未成功。'
    restore_prepared=true
    apply_restore_context "$restore_id"
    CONFIG_FILE="$ROOT/.local/operations/restores/$restore_id/config.env"
    SECRET_FILE="$ROOT/.local/operations/restores/$restore_id/secrets.env"
    RELEASE_FILE="$ROOT/.local/operations/restores/$restore_id/release.env"
    require_config
    require_release
    CHATBI_BOUND_DATABASE_IMAGE="$CHATBI_DATABASE_IMAGE"
    CHATBI_BOUND_DATABASE_IMAGE_ID="$CHATBI_DATABASE_IMAGE_ID"
    export CHATBI_BOUND_DATABASE_IMAGE CHATBI_BOUND_DATABASE_IMAGE_ID
    verify_candidate_release_assets
    require_restore_model_cache
    model_path="$(read_config_value CHATBI_LOCAL_MODEL_DIR)"
    [[ "$model_path" == /* ]] || model_path="$ROOT/$model_path"
    if ! local_loopback_port_is_free "$port"; then
        fail "隔离候选回环端口 ${port} 已被占用；不会停止占用进程。"
    fi
    mkdir -m 700 "$CHATBI_BOUND_STATE_DIR"
    create_restore_volumes "$restore_id" "$CHATBI_BOUND_POSTGRES_VOLUME" "$CHATBI_BOUND_QDRANT_VOLUME"
    candidate_context_active=true
    check_compose_config
    restore_project_compose up -d postgres qdrant \
        || fail '隔离 PostgreSQL / Qdrant 启动失败；卷保留且不会触及稳定环境。'
    wait_for_restore_postgres \
        || fail '隔离 PostgreSQL 未就绪；卷保留且不会触及稳定环境。'
    restore_project_compose exec -T postgres sh /workspace/database/init/wait_for_base_initialization.sh \
        || fail '隔离 PostgreSQL 基础初始化失败；卷保留。'
    restore_project_compose run --rm -T qdrant-check wait-qdrant \
        || fail '隔离 Qdrant 未就绪；卷保留。'
    restore_tool restore-databases --root /state --restore-id "$restore_id" --host-locked \
        || fail '隔离数据库导入或全表指纹核验失败；候选不会标记为 verified。'
    restore_project_compose run --rm -T --no-deps model build-rag \
        || fail '固定模型 RAG 重建失败；候选不会标记为 verified。'
    restore_project_compose run --rm -T --no-deps verify verify-runtime \
        || fail '隔离候选兼容 / RAG / readiness 门禁失败。'
    credentials="$("$ROOT/.venv/bin/python" "$ROOT/scripts/local_restore_credentials.py" --restore-id "$restore_id")" \
        || fail '无法生成一次性恢复核验账号；候选不会标记为 verified。'
    [[ -n "$credentials" ]] || fail '一次性恢复核验账号为空。'
    temp_identity_active=true
    printf '%s' "$credentials" | restore_tool temp-identity --identity-action prepare \
        --root /state --restore-id "$restore_id" --host-locked \
        || fail '无法建立隔离临时账号和历史快照副本；候选不会标记为 verified。'
    restore_project_compose up -d --no-deps api \
        || fail '隔离候选 API 启动失败；候选资源保留。'
    wait_for_restore_api \
        || fail '隔离候选 API HTTP 健康检查失败；候选资源保留。'
    login_result="$(printf '%s' "$credentials" | python3 "$ROOT/scripts/local_restore_login.py" \
        --port "$port" --credentials-stdin)" \
        || fail '候选登录或历史只读核验失败；候选不会标记为 verified。'
    duration=$(( SECONDS - RESTORE_STARTED ))
    (( duration <= 1800 )) || fail '完整恢复超过 30 分钟目标；未登记为达标候选。'
    # Stop the app writer and remove the temporary identity before recording proof.
    stop_candidate_service "$PROJECT_NAME" api
    restore_tool temp-identity --identity-action cleanup --root /state \
        --restore-id "$restore_id" --host-locked \
        || fail '临时核验账号 / 历史副本未能清理；候选保持未验证。'
    temp_identity_active=false
    credentials=''
    write_restore_verification "$login_result" "$duration"
    restore_tool mark-verified --root /state --restore-id "$restore_id" \
        --verification-file "/state/operations/restores/$restore_id/verification.json" --host-locked \
        || fail 'Session / execution fencing 未通过；候选保持未验证。'
    rm -f -- "$ROOT/.local/operations/restores/$restore_id/verification.json"
    stop_candidate_project "$PROJECT_NAME"
    require_candidate_project_stopped "$PROJECT_NAME"
    [[ -z "$(docker ps --quiet --filter "volume=$CHATBI_BOUND_POSTGRES_VOLUME")" \
        && -z "$(docker ps --quiet --filter "volume=$CHATBI_BOUND_QDRANT_VOLUME")" ]] \
        || fail '隔离恢复卷仍有运行容器附着；候选保持未验证。'
    restore_tool clear-payload --root /state --restore-id "$restore_id" --host-locked \
        || fail '候选已验证，但隔离明文 staging 清理失败；人工检查后再激活。'
    candidate_context_active=false
    trap - EXIT
    printf '隔离恢复已验证并停止：%s\n数据库 / 全表指纹、角色与 grants、会话撤销、运行代际、RAG readiness、交互登录和历史只读均已核验。\n候选数据卷已保留；激活需单独执行 ./local restore-activate %s。\n' \
        "$restore_id" "$restore_id"
}

mark_restore_journal_interrupted() {
    local restore_id="$1" phase="$2"
    restore_state_cli journal-phase --restore-id "$restore_id" --phase "$phase" \
        --state interrupted >/dev/null 2>&1 || true
}

restore_activate() {
    local restore_id="$1" phase=candidate-stopping previous_environment_id="$CHATBI_BOUND_ENVIRONMENT_ID"
    local previous_config="$CONFIG_FILE"
    local previous_secret="$SECRET_FILE" previous_release="$RELEASE_FILE"
    local PREVIOUS_RUNTIME_RELEASE_FILE='' PREVIOUS_RUNTIME_RELEASE_REF=''
    local PREVIOUS_RUNTIME_API_IMAGE='' PREVIOUS_RUNTIME_API_IMAGE_ID=''
    local PREVIOUS_RUNTIME_DATABASE_IMAGE='' PREVIOUS_RUNTIME_DATABASE_IMAGE_ID=''
    [[ "$restore_id" =~ ^[0-9a-f]{32}$ ]] || fail 'restore-activate 只接受完整恢复 ID。'
    require_docker
    prepare_operations_directories
    require_operations_image
    require_config
    if [[ "$previous_environment_id" == legacy ]]; then
        capture_previous_runtime
        previous_release="$PREVIOUS_RUNTIME_RELEASE_FILE"
        RELEASE_FILE="$previous_release"
        require_release
    else
        require_release
    fi
    verify_release_images
    if [[ "$previous_environment_id" != legacy ]]; then
        verify_bound_database_image
    fi
    verify_bound_volume postgres || fail '原 stable PostgreSQL 卷归属未确认；拒绝丢失 previous。'
    verify_bound_volume qdrant || fail '原 stable Qdrant 卷归属未确认；拒绝丢失 previous。'
    verify_bound_single_writer
    apply_restore_context "$restore_id"
    local CONFIG_FILE="$ROOT/.local/operations/restores/$restore_id/config.env"
    local SECRET_FILE="$ROOT/.local/operations/restores/$restore_id/secrets.env"
    local RELEASE_FILE="$ROOT/.local/operations/restores/$restore_id/release.env"
    local PROJECT_NAME=chatbi-stable
    require_config
    require_release
    [[ -f "$previous_config" && -f "$previous_secret" && -f "$previous_release" ]] \
        || fail '原稳定环境的配置或固定发布记录缺失；无法保留可恢复的 previous。'
    verify_candidate_release_assets
    require_restore_model_cache
    require_restore_volume_labels "$restore_id" postgres "$CHATBI_BOUND_POSTGRES_VOLUME"
    require_restore_volume_labels "$restore_id" qdrant "$CHATBI_BOUND_QDRANT_VOLUME"
    [[ -d "$CHATBI_BOUND_RAG_DIR" && ! -L "$CHATBI_BOUND_RAG_DIR" \
        && -d "$CHATBI_BOUND_OPERATIONS_API_DIR" && ! -L "$CHATBI_BOUND_OPERATIONS_API_DIR" ]] \
        || fail '已验证候选的 RAG 或运行状态目录缺失。'
    if [[ "$previous_environment_id" == legacy ]]; then
        restore_state_cli journal-begin --restore-id "$restore_id" \
            --previous-release-file "$PREVIOUS_RUNTIME_RELEASE_REF" \
            --previous-database-image "$PREVIOUS_RUNTIME_DATABASE_IMAGE" \
            --previous-database-image-id "$PREVIOUS_RUNTIME_DATABASE_IMAGE_ID" >/dev/null \
            || fail '恢复候选未验证，或已有未完成切换日志；先核对 ./local status。'
    else
        restore_state_cli journal-begin --restore-id "$restore_id" >/dev/null \
            || fail '恢复候选未验证，或已有未完成切换日志；先核对 ./local status。'
    fi
    local restore_activation_phase="$phase"
    RESTORE_JOURNAL_EXIT_ID="$restore_id"
    RESTORE_JOURNAL_EXIT_PHASE="$restore_activation_phase"
    restore_activation_exit() {
        local result=$?
        trap - EXIT
        if (( result != 0 )); then
            mark_restore_journal_interrupted "$RESTORE_JOURNAL_EXIT_ID" "$RESTORE_JOURNAL_EXIT_PHASE"
            printf '切换阶段未完成；所有资源与 journal 均保留，请显式执行 restore-recover。\n' >&2
        fi
    }
    trap restore_activation_exit EXIT

    stop_candidate_project "chatbi-restore-$restore_id"
    require_candidate_project_stopped "chatbi-restore-$restore_id"
    [[ -z "$(docker ps --quiet --filter "volume=$CHATBI_BOUND_POSTGRES_VOLUME")" \
        && -z "$(docker ps --quiet --filter "volume=$CHATBI_BOUND_QDRANT_VOLUME")" ]] \
        || fail '候选卷仍被隔离项目中的运行容器占用。'
    restore_state_cli journal-phase --restore-id "$restore_id" --phase candidate-stopped \
        --state activating >/dev/null || fail '无法记录候选停止阶段。'
    RESTORE_JOURNAL_EXIT_PHASE=candidate-stopped
    phase=previous-stopping
    restore_activation_phase="$phase"
    RESTORE_JOURNAL_EXIT_PHASE="$restore_activation_phase"
    restore_state_cli journal-phase --restore-id "$restore_id" --phase "$phase" \
        --state activating >/dev/null || fail '无法记录 previous 停止阶段。'
    stop_stable_services
    [[ -z "$(docker ps --quiet --filter "volume=$CHATBI_BOUND_POSTGRES_VOLUME")" ]] \
        || fail '切换目标 PostgreSQL 卷仍有运行 writer。'
    restore_state_cli journal-phase --restore-id "$restore_id" --phase previous-stopped \
        --state activating >/dev/null || fail '无法记录 previous 停止完成。'
    RESTORE_JOURNAL_EXIT_PHASE=previous-stopped
    phase=binding-switched
    restore_activation_phase="$phase"
    RESTORE_JOURNAL_EXIT_PHASE="$restore_activation_phase"
    restore_state_cli activate-select --restore-id "$restore_id" >/dev/null \
        || fail '无法原子切换活动资源绑定。'
    resolve_runtime_binding
    require_config
    require_release
    prepare_host_directories
    ensure_bound_volumes
    verify_candidate_release_assets
    phase=candidate-starting
    restore_activation_phase="$phase"
    RESTORE_JOURNAL_EXIT_PHASE="$restore_activation_phase"
    restore_state_cli journal-phase --restore-id "$restore_id" --phase "$phase" \
        --state activating >/dev/null || fail '无法记录候选启动阶段。'
    start_infrastructure true
    compose run --rm -T --no-deps verify verify-runtime \
        || fail '活动候选启动前 readiness / 数据兼容门禁失败；绑定保持候选状态。'
    record_deployment_state begin up "$CHATBI_SOURCE_COMMIT" restore-activate transitioning
    run_target_api up "$CHATBI_SOURCE_COMMIT" restore-activate
    phase=candidate-verified
    restore_activation_phase="$phase"
    RESTORE_JOURNAL_EXIT_PHASE="$restore_activation_phase"
    restore_state_cli journal-phase --restore-id "$restore_id" --phase "$phase" \
        --state activating >/dev/null || fail '无法记录候选服务核验完成。'
    restore_state_cli record-activated --restore-id "$restore_id" >/dev/null \
        || fail '候选已运行，但无法原子登记 activated 状态。'
    restore_state_cli journal-complete --restore-id "$restore_id" >/dev/null \
        || fail '候选已运行，但切换 journal 未能完成；需显式 recover。'
    trap - EXIT
    RESTORE_JOURNAL_EXIT_ID=''
    RESTORE_JOURNAL_EXIT_PHASE=''
    start_backup_scheduler
    printf '恢复候选已切换为稳定资源：%s\n原 stable 卷、RAG 与配置保留；如需选择环境，运行 ./local restore-recover %s --previous|--candidate。\n' \
        "$restore_id" "$restore_id"
}

restore_recover() {
    local restore_id="$1" choice="$2" phase=recover-stopping
    [[ "$restore_id" =~ ^[0-9a-f]{32}$ && "$choice" =~ ^(previous|candidate)$ ]] \
        || fail '用法：./local restore-recover <恢复ID> --previous|--candidate'
    require_docker
    prepare_operations_directories
    require_operations_image
    local PROJECT_NAME=chatbi-stable
    restore_state_cli recover-begin --restore-id "$restore_id" --choice "$choice" >/dev/null \
        || fail '恢复 journal 不存在、已完成或 ID 不匹配；不会推测切换方向。'
    RESTORE_JOURNAL_EXIT_ID="$restore_id"
    RESTORE_JOURNAL_EXIT_PHASE="$phase"
    restore_recovery_exit() {
        local result=$?
        trap - EXIT
        if (( result != 0 )); then
            mark_restore_journal_interrupted "$RESTORE_JOURNAL_EXIT_ID" "$RESTORE_JOURNAL_EXIT_PHASE"
            printf '显式恢复尚未完成；资源与 journal 保留，请按状态核对后再次指定方向。\n' >&2
        fi
    }
    trap restore_recovery_exit EXIT
    stop_candidate_project "chatbi-restore-$restore_id"
    require_candidate_project_stopped "chatbi-restore-$restore_id"
    stop_stable_services
    phase=recover-stopped
    RESTORE_JOURNAL_EXIT_PHASE="$phase"
    restore_state_cli journal-phase --restore-id "$restore_id" --phase "$phase" \
        --state recovering --choice "$choice" >/dev/null \
        || fail '无法记录显式恢复的停止完成阶段。'
    phase=recover-binding-switched
    RESTORE_JOURNAL_EXIT_PHASE="$phase"
    restore_state_cli recover-select --restore-id "$restore_id" --choice "$choice" >/dev/null \
        || fail '无法切换到操作者明确选择的资源绑定。'
    resolve_runtime_binding
    require_config
    require_release
    [[ -d "$CHATBI_BOUND_RAG_DIR" && ! -L "$CHATBI_BOUND_RAG_DIR" ]] \
        || fail '显式选择的 RAG 目录缺失或类型错误；不会创建空目录替代 previous/candidate。'
    require_restore_model_cache
    verify_bound_volume postgres
    verify_bound_volume qdrant
    verify_bound_single_writer
    prepare_host_directories
    verify_release_images
    phase=recover-starting
    RESTORE_JOURNAL_EXIT_PHASE="$phase"
    restore_state_cli journal-phase --restore-id "$restore_id" --phase "$phase" \
        --state recovering --choice "$choice" >/dev/null \
        || fail '无法记录所选资源启动阶段。'
    start_infrastructure true
    compose run --rm -T --no-deps verify verify-runtime \
        || fail '显式选择的资源未通过 compatibility / readiness 门禁；journal 保留。'
    record_deployment_state begin up "$CHATBI_SOURCE_COMMIT" restore-recover transitioning
    run_target_api up "$CHATBI_SOURCE_COMMIT" restore-recover
    if [[ "$choice" == candidate ]]; then
        restore_state_cli record-activated --restore-id "$restore_id" >/dev/null \
            || fail '候选已恢复运行，但 activated 登记失败。'
    fi
    restore_state_cli journal-complete --restore-id "$restore_id" >/dev/null \
        || fail '所选资源已运行，但 journal 未能完成；请再次显式核验。'
    trap - EXIT
    RESTORE_JOURNAL_EXIT_ID=''
    RESTORE_JOURNAL_EXIT_PHASE=''
    start_backup_scheduler
    printf '已按显式选择恢复 %s 资源绑定：%s。\n' "$choice" "$restore_id"
}

prepare_host_directories() {
    local model_path
    model_path="$(read_config_value CHATBI_LOCAL_MODEL_DIR)"
    [[ -n "$model_path" ]] || fail 'CHATBI_LOCAL_MODEL_DIR 不能为空。'
    if [[ "$model_path" != /* ]]; then
        model_path="$ROOT/$model_path"
    fi
    if [[ "$CHATBI_BOUND_ENVIRONMENT_ID" == legacy ]]; then
        mkdir -p "$CHATBI_BOUND_RAG_DIR"
    else
        [[ -d "$CHATBI_BOUND_RAG_DIR" && ! -L "$CHATBI_BOUND_RAG_DIR" ]] \
            || fail '已登记恢复环境的 RAG 目录缺失或类型无效；拒绝静默创建替代目录。'
    fi
    mkdir -p "$model_path"
    prepare_operations_directories
    if [[ "$CHATBI_BOUND_ENVIRONMENT_ID" != legacy ]]; then
        [[ -d "$CHATBI_BOUND_OPERATIONS_API_DIR" && ! -L "$CHATBI_BOUND_OPERATIONS_API_DIR" ]] \
            || fail '已登记恢复环境的 API 状态目录缺失或类型无效。'
    fi
}

check_compose_config() {
    compose config --quiet || fail 'Compose 配置无效；检查 .env.local 和 .env.local.secrets。'
}

verify_release_images() {
    require_release
    local actual_id revision release_json expected_json compatibility_json

    actual_id="$(docker image inspect --format '{{.Id}}' "$CHATBI_API_IMAGE" 2>/dev/null)" \
        || fail '当前 API 镜像不存在；运行 ./local build。'
    [[ "$actual_id" == "$CHATBI_API_IMAGE_ID" ]] \
        || fail 'API 镜像 ID 与本地发布记录不一致；拒绝启动。'
    revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$CHATBI_API_IMAGE")"
    [[ "$revision" == "$CHATBI_SOURCE_COMMIT" ]] \
        || fail 'API 镜像 revision label 与本地发布记录不一致。'
    release_json="$(docker run --rm --entrypoint /bin/cat "$CHATBI_API_IMAGE" /opt/chatbi-release.json)" \
        || fail '无法读取 API 镜像来源身份。'
    expected_json="$(printf '{"format":1,"source_commit":"%s"}' "$CHATBI_SOURCE_COMMIT")"
    [[ "$release_json" == "$expected_json" ]] \
        || fail 'API 镜像内嵌来源身份与本地发布记录不一致。'
    compatibility_json="$(docker run --rm --entrypoint /bin/cat "$CHATBI_API_IMAGE" /opt/chatbi-compatibility.json 2>/dev/null)" \
        || fail 'API 镜像缺少兼容性声明；拒绝启动、升级或回滚。'
    [[ -n "$compatibility_json" ]] \
        || fail 'API 镜像兼容性声明为空；拒绝启动、升级或回滚。'

    if [[ -n "$CHATBI_BOUND_DATABASE_IMAGE" || -n "$CHATBI_BOUND_DATABASE_IMAGE_ID" ]]; then
        verify_bound_database_image
        return 0
    fi

    actual_id="$(docker image inspect --format '{{.Id}}' "$CHATBI_DATABASE_IMAGE" 2>/dev/null)" \
        || fail '当前 PostgreSQL 镜像不存在；运行 ./local build。'
    [[ "$actual_id" == "$CHATBI_DATABASE_IMAGE_ID" ]] \
        || fail 'PostgreSQL 镜像 ID 与本地发布记录不一致；拒绝启动。'
    revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$CHATBI_DATABASE_IMAGE")"
    [[ "$revision" == "$CHATBI_SOURCE_COMMIT" ]] \
        || fail 'PostgreSQL 镜像 revision label 与本地发布记录不一致。'
    release_json="$(docker run --rm --entrypoint /bin/cat "$CHATBI_DATABASE_IMAGE" /opt/chatbi-release.json)" \
        || fail '无法读取 PostgreSQL 镜像来源身份。'
    [[ "$release_json" == "$expected_json" ]] \
        || fail 'PostgreSQL 镜像内嵌来源身份与本地发布记录不一致。'
}

build_images() {
    require_docker
    local dirty source_commit cache_commit api_build_tag database_build_tag
    dirty="$(git -C "$ROOT" status --porcelain --untracked-files=all)"
    [[ -z "$dirty" ]] || fail '固定版本构建要求 clean worktree；先提交当前目标改动。'
    source_commit="$(git -C "$ROOT" rev-parse HEAD)"
    [[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] || fail '无法识别当前 Git commit。'
    [[ ! -e "$RELEASE_DIR/$source_commit.env" ]] \
        || fail '该 source commit 已有不可变本地发布记录；需要新 commit 才能创建另一候选。'
    cache_commit="$(select_build_cache_commit "$source_commit" "$ROOT")"

    docker build --check \
        --file "$ROOT/docker/local.Dockerfile" \
        --target api \
        --build-arg "CHATBI_SOURCE_COMMIT=$cache_commit" \
        --build-arg "CHATBI_RELEASE_COMMIT=$source_commit" \
        "$ROOT"
    api_build_tag="chatbi-local-api:build-${source_commit}"
    docker build \
        --file "$ROOT/docker/local.Dockerfile" \
        --target api \
        --build-arg "CHATBI_SOURCE_COMMIT=$cache_commit" \
        --build-arg "CHATBI_RELEASE_COMMIT=$source_commit" \
        --tag "$api_build_tag" \
        "$ROOT"

    docker build --check \
        --file "$ROOT/docker/local.Dockerfile" \
        --target database \
        --build-arg "CHATBI_SOURCE_COMMIT=$cache_commit" \
        --build-arg "CHATBI_RELEASE_COMMIT=$source_commit" \
        "$ROOT"
    database_build_tag="chatbi-local-postgres:build-${source_commit}"
    docker build \
        --file "$ROOT/docker/local.Dockerfile" \
        --target database \
        --build-arg "CHATBI_SOURCE_COMMIT=$cache_commit" \
        --build-arg "CHATBI_RELEASE_COMMIT=$source_commit" \
        --tag "$database_build_tag" \
        "$ROOT"

    local api_id database_id api_tag database_tag api_size database_size release_tmp
    local record_tmp original_release_file="$RELEASE_FILE"
    api_id="$(docker image inspect --format '{{.Id}}' "$api_build_tag")"
    database_id="$(docker image inspect --format '{{.Id}}' "$database_build_tag")"
    api_tag="chatbi-local-api:${source_commit:0:12}-${api_id#sha256:}"
    database_tag="chatbi-local-postgres:${source_commit:0:12}-${database_id#sha256:}"
    docker image tag "$api_id" "$api_tag"
    docker image tag "$database_id" "$database_tag"
    api_size="$(docker image inspect --format '{{.Size}}' "$api_tag")"
    database_size="$(docker image inspect --format '{{.Size}}' "$database_tag")"

    mkdir -p "${RELEASE_FILE%/*}" "$RELEASE_DIR"
    release_tmp="$RELEASE_FILE.tmp.$$"
    record_tmp="$RELEASE_DIR/$source_commit.env.tmp.$$"
    umask 077
    cat > "$release_tmp" <<EOF
CHATBI_SOURCE_COMMIT=$source_commit
CHATBI_API_IMAGE=$api_tag
CHATBI_API_IMAGE_ID=$api_id
CHATBI_DATABASE_IMAGE=$database_tag
CHATBI_DATABASE_IMAGE_ID=$database_id
EOF
    chmod 600 "$release_tmp"
    RELEASE_FILE="$release_tmp"
    verify_release_images
    RELEASE_FILE="$original_release_file"
    cp "$release_tmp" "$record_tmp"
    chmod 600 "$record_tmp"
    mv "$record_tmp" "$RELEASE_DIR/$source_commit.env"
    mv -f "$release_tmp" "$RELEASE_FILE"
    printf '固定版本构建完成。release source commit: %s\nDocker layer cache source commit: %s\nAPI: %s (%s, %s bytes)\nPostgreSQL: %s (%s, %s bytes)\n' \
        "$source_commit" "$cache_commit" "$api_tag" "$api_id" "$api_size" \
        "$database_tag" "$database_id" "$database_size"
}

select_release() {
    local source_commit="$1"
    [[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] \
        || fail 'upgrade / rollback 必须指定完整 40 位 source commit。'
    RELEASE_FILE="$RELEASE_DIR/$source_commit.env"
    [[ -f "$RELEASE_FILE" ]] \
        || fail "本机没有 source commit ${source_commit} 的固定版本记录；运行 ./local build 构建候选。"
    require_release
    [[ "$CHATBI_SOURCE_COMMIT" == "$source_commit" ]] \
        || fail '指定 source commit 与本机发布记录不一致。'
}

initialize_config() {
    command -v openssl >/dev/null 2>&1 || fail '生成独立随机密钥需要 WSL/Linux 中的 openssl。'
    if [[ ! -e "$CONFIG_FILE" ]]; then
        umask 077
        cp "$ROOT/.env.local.example" "$CONFIG_FILE"
        chmod 600 "$CONFIG_FILE"
        printf '已创建独立配置 .env.local。\n'
    else
        printf '保留已有 .env.local，不覆盖。\n'
    fi
    if [[ ! -e "$SECRET_FILE" ]]; then
        local secret_tmp
        secret_tmp="$SECRET_FILE.tmp.$$"
        umask 077
        {
            printf 'POSTGRES_MIGRATOR_PASSWORD='
            openssl rand -hex 32
            printf 'POSTGRES_APP_PASSWORD='
            openssl rand -hex 32
            printf 'POSTGRES_CONTROL_APP_PASSWORD='
            openssl rand -hex 32
            printf 'CHATBI_ADMIN_SECRET_KEY='
            openssl rand -hex 32
            printf 'QDRANT_API_KEY='
            openssl rand -hex 32
        } > "$secret_tmp"
        chmod 600 "$secret_tmp"
        mv -n "$secret_tmp" "$SECRET_FILE"
        rm -f "$secret_tmp"
        printf '已创建独立随机凭据 .env.local.secrets（权限 600）。\n'
    else
        printf '保留已有 .env.local.secrets，不覆盖。\n'
    fi
    prepare_host_directories
    printf '完成。编辑 .env.local 填入外部 LLM_API_KEY，再执行 ./local build。\n'
}

start_infrastructure() {
    local preserve_database_image="${1:-false}"
    require_config
    require_release
    require_docker
    prepare_host_directories
    ensure_bound_volumes
    check_compose_config
    local selected_database_image="$CHATBI_DATABASE_IMAGE" database_container runtime_database_image
    if [[ "$preserve_database_image" == true ]]; then
        database_container=""
        local fallback_database_container='' container database_running
        while IFS= read -r container; do
            [[ -n "$container" ]] || continue
            database_running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
            if [[ "$database_running" == true ]]; then
                database_container="$container"
                break
            fi
            [[ -n "$fallback_database_container" ]] || fallback_database_container="$container"
        done < <(stable_container_ids postgres)
        [[ -n "$database_container" ]] || database_container="$fallback_database_container"
        if [[ -n "$database_container" ]]; then
            runtime_database_image="$(docker inspect --format '{{.Config.Image}}' "$database_container")"
            [[ "$runtime_database_image" == chatbi-local-postgres:* ]] \
                || fail '稳定 PostgreSQL 容器镜像身份未知；拒绝替换数据库容器。'
            CHATBI_DATABASE_IMAGE="$runtime_database_image"
            export CHATBI_DATABASE_IMAGE
        fi
    fi
    compose up -d postgres qdrant
    CHATBI_DATABASE_IMAGE="$selected_database_image"
    export CHATBI_DATABASE_IMAGE
    compose exec -T postgres sh /workspace/database/init/wait_for_base_initialization.sh \
        || fail 'PostgreSQL 基础初始化失败；检查 ./local logs postgres。未删除任何数据。'
    compose run --rm -T qdrant-check wait-qdrant
    printf '稳定 PostgreSQL 与 Qdrant 已启动；数据库空卷上的合成 Sales Mart 仅由首次镜像初始化创建。\n'
}

wait_for_api() {
    local container state attempt
    for attempt in $(seq 1 90); do
        container="$(compose ps -q api)"
        if [[ -n "$container" ]]; then
            state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)"
            if [[ "$state" == healthy ]]; then
                return 0
            fi
            if [[ "$state" == unhealthy || "$state" == exited || "$state" == dead ]]; then
                return 1
            fi
        fi
        sleep 2
    done
    return 1
}

stable_api_serves_configured_port() {
    local port="$1" container running published_port
    container="$(compose ps -q api)"
    [[ -n "$container" ]] || return 1
    running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
    [[ "$running" == true ]] || return 1
    published_port="$(docker port "$container" 8000/tcp 2>/dev/null || true)"
    [[ "$published_port" == "127.0.0.1:$port" ]] || return 1
    local_loopback_http_health_ok "$port"
}

ensure_local_api_port_available() {
    local port container running
    port="$(read_config_value CHATBI_LOCAL_HTTP_PORT)"
    container="$(compose ps -q api)"
    if [[ -n "$container" ]]; then
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        if [[ "$running" == true ]] && stable_api_serves_configured_port "$port"; then
            return 0
        fi
        if [[ "$running" == true ]]; then
            compose stop api >/dev/null \
                || fail '无法停止本稳定环境中未正确发布的 API 容器；未处理其他进程。'
        fi
    fi
    if ! local_loopback_port_is_free "$port"; then
        fail "本机回环端口 ${port} 已被占用；请修改 .env.local 中的 CHATBI_LOCAL_HTTP_PORT 后重试。未停止占用进程。"
    fi
}

record_deployment_state() {
    local event="$1" operation="$2" target="$3" phase="$4" runtime_status="$5"
    shift 5
    local -a state_args=(
        --event "$event"
        --operation "$operation"
        --phase "$phase"
        --runtime-status "$runtime_status"
    )
    [[ "$target" == - ]] || state_args+=(--target-commit "$target")
    local release_role=active
    if [[ "${1:-}" == --baseline ]]; then
        release_role=baseline
        shift
    fi
    if (( $# == 5 )); then
        append_deployment_release_arguments state_args "$release_role" "$@"
        shift 5
    elif (( $# != 0 )); then
        fail '部署状态 release 身份必须提供五个字段。'
    fi
    (( $# == 0 )) || fail '部署状态参数数量错误。'
    compose run --rm -T --no-deps verify record-state "${state_args[@]}"
}

capture_running_api_release() {
    local api_container='' container running identity
    RUNNING_SOURCE_COMMIT=''
    RUNNING_API_IMAGE=''
    RUNNING_API_IMAGE_ID=''
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        if [[ "$running" == true ]]; then
            api_container="$container"
            break
        fi
    done < <(stable_container_ids api)
    [[ -n "$api_container" ]] || return 1
    identity="$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}|{{.Config.Image}}|{{.Image}}' "$api_container")"
    IFS='|' read -r RUNNING_SOURCE_COMMIT RUNNING_API_IMAGE RUNNING_API_IMAGE_ID <<< "$identity"
    [[ "$RUNNING_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]] \
        || fail '当前稳定 API 缺少可信 source commit；拒绝升级或回滚。'
    [[ "$RUNNING_API_IMAGE" == chatbi-local-api:* && "$RUNNING_API_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
        || fail '当前稳定 API 镜像身份无效；拒绝升级或回滚。'
    return 0
}

capture_running_release() {
    local database_container='' container running identity
    RUNNING_DATABASE_IMAGE=''
    RUNNING_DATABASE_IMAGE_ID=''
    capture_running_api_release || return 1
    while IFS= read -r container; do
        [[ -n "$container" ]] || continue
        running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
        if [[ "$running" == true ]]; then
            database_container="$container"
            break
        fi
    done < <(stable_container_ids postgres)
    [[ -n "$database_container" ]] || fail '稳定 PostgreSQL 未运行；拒绝升级或回滚。'
    identity="$(docker inspect --format '{{.Config.Image}}|{{.Image}}' "$database_container")"
    IFS='|' read -r RUNNING_DATABASE_IMAGE RUNNING_DATABASE_IMAGE_ID <<< "$identity"
    [[ "$RUNNING_DATABASE_IMAGE" == chatbi-local-postgres:* && "$RUNNING_DATABASE_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
        || fail '稳定 PostgreSQL 镜像身份无效；拒绝升级或回滚。'
    return 0
}

target_database_runtime_identity() {
    local container candidate
    container=""
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if [[ "$(docker inspect --format '{{.State.Running}}' "$candidate" 2>/dev/null || true)" == true ]]; then
            container="$candidate"
            break
        fi
    done < <(stable_container_ids postgres)
    [[ -n "$container" ]] || return 1
    TARGET_DATABASE_RUNTIME_IMAGE="$(docker inspect --format '{{.Config.Image}}' "$container")"
    TARGET_DATABASE_RUNTIME_IMAGE_ID="$(docker inspect --format '{{.Image}}' "$container")"
    [[ "$TARGET_DATABASE_RUNTIME_IMAGE" == chatbi-local-postgres:* && "$TARGET_DATABASE_RUNTIME_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]]
}

api_runtime_status() {
    local container running health
    container="$(compose ps -q api)"
    if [[ -z "$container" ]]; then
        printf 'unknown\n'
        return 0
    fi
    running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
    if [[ "$running" != true ]]; then
        printf 'stopped\n'
        return 0
    fi
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "$container" 2>/dev/null || true)"
    if [[ "$health" == healthy ]]; then
        printf 'running\n'
    else
        printf 'unhealthy\n'
    fi
}

mark_operation_failed() {
    local operation="$1" target="$2" phase="$3" runtime_status="$4"
    record_deployment_state failed "$operation" "$target" "$phase" "$runtime_status" \
        || printf '未能写入失败阶段；请查看 ./local status 和 ./local logs。\n' >&2
}

run_target_api() {
    local operation="$1" target="$2" phase="$3"
    local port
    port="$(read_config_value CHATBI_LOCAL_HTTP_PORT)"
    if ! local_loopback_port_is_free "$port"; then
        mark_operation_failed "$operation" "$target" "${phase}-port-check" stopped
        fail "本机回环端口 ${port} 已被其他进程占用；未处理该进程。"
    fi
    record_deployment_state phase "$operation" "$target" starting-api stopped
    if ! compose up -d --no-deps api; then
        if complete_started_api "$operation" "$target" "$port"; then
            return 0
        fi
        local runtime_status
        runtime_status="$(api_runtime_status)"
        if [[ "$runtime_status" == running ]]; then
            compose stop api >/dev/null || true
            runtime_status=stopped
        fi
        mark_operation_failed "$operation" "$target" starting-api "$runtime_status"
        fail '目标 API 启动失败；数据库和发布记录保留，可检查稳定环境日志。'
    fi
    if ! wait_for_api; then
        if complete_started_api "$operation" "$target" "$port"; then
            return 0
        fi
        local runtime_status
        runtime_status="$(api_runtime_status)"
        if [[ "$runtime_status" == running ]]; then
            compose stop api >/dev/null || true
            runtime_status=stopped
        fi
        mark_operation_failed "$operation" "$target" waiting-for-api "$runtime_status"
        fail '目标 API 未通过健康检查；数据保留，可检查 ./local status 和 ./local logs api。'
    fi
    if ! stable_api_serves_configured_port "$port"; then
        compose stop api >/dev/null || true
        mark_operation_failed "$operation" "$target" verifying-api stopped
        fail '目标 API 健康检查未能确认本机回环端口；未知占用进程未被处理。'
    fi
    if ! target_database_runtime_identity; then
        compose stop api >/dev/null || true
        mark_operation_failed "$operation" "$target" verifying-runtime stopped
        fail '稳定 PostgreSQL 运行镜像身份无法确认。'
    fi
    if ! record_target_success "$operation" "$target"; then
        compose stop api >/dev/null || true
        mark_operation_failed "$operation" "$target" recording-active-release stopped
        fail 'API 已通过健康检查，但 active release 无法原子记录；已停止本稳定环境 API。'
    fi
}

complete_started_api() {
    local operation="$1" target="$2" port="$3"
    stable_api_serves_configured_port "$port" || return 1
    if ! target_database_runtime_identity; then
        compose stop api >/dev/null || true
        mark_operation_failed "$operation" "$target" verifying-runtime stopped
        fail '稳定 PostgreSQL 运行镜像身份无法确认。'
    fi
    if ! record_target_success "$operation" "$target"; then
        compose stop api >/dev/null || true
        mark_operation_failed "$operation" "$target" recording-active-release stopped
        fail 'API 已通过健康检查，但 active release 无法原子记录；已停止本稳定环境 API。'
    fi
    return 0
}

record_target_success() {
    local operation="$1" target="$2"
    target_database_runtime_identity || return 1
    record_deployment_state succeeded "$operation" "$target" running running \
        "$CHATBI_SOURCE_COMMIT" "$CHATBI_API_IMAGE" "$CHATBI_API_IMAGE_ID" \
        "$TARGET_DATABASE_RUNTIME_IMAGE" "$TARGET_DATABASE_RUNTIME_IMAGE_ID"
}

upgrade_release() {
    local operation="$1" source_commit="$2" previous=()
    require_config
    require_release
    require_docker
    prepare_host_directories
    check_compose_config
    verify_release_images
    if [[ "$operation" == upgrade ]]; then
        # Source capture reads Docker's old active identity, never the selected target.
        run_manual_backup
    fi
    start_infrastructure true
    if ! compose run --rm -T --no-deps verify verify-runtime; then
        fail '目标发布与当前持久化状态不兼容；API 未停止，数据未修改。'
    fi
    if capture_running_release; then
        previous=(
            "$RUNNING_SOURCE_COMMIT" "$RUNNING_API_IMAGE" "$RUNNING_API_IMAGE_ID"
            "$RUNNING_DATABASE_IMAGE" "$RUNNING_DATABASE_IMAGE_ID"
        )
    fi
    record_deployment_state begin "$operation" "$source_commit" stopping-api transitioning --baseline "${previous[@]}"
    if ! compose stop api; then
        mark_operation_failed "$operation" "$source_commit" stopping-api unknown
        fail '无法确认当前 API 已停止；数据库和数据卷未清理。'
    fi
    if [[ "$operation" == upgrade ]]; then
        record_deployment_state phase "$operation" "$source_commit" migrating stopped
        if ! compose run --rm -T --no-deps migrator; then
            mark_operation_failed "$operation" "$source_commit" migrating stopped
            fail '目标 migration 失败；没有执行反向 migration 或清理数据，可显式恢复兼容版本。'
        fi
        record_deployment_state phase "$operation" "$source_commit" verifying-target stopped
        if ! compose run --rm -T --no-deps verify verify-runtime; then
            mark_operation_failed "$operation" "$source_commit" verifying-target stopped
            fail 'migration 后兼容检查失败；没有启动目标 API 或回退数据库。'
        fi
    else
        record_deployment_state phase "$operation" "$source_commit" starting-api stopped
    fi
    run_target_api "$operation" "$source_commit" starting-api
    start_backup_scheduler
    printf 'ChatBI %s 完成：http://127.0.0.1:%s/\n版本：%s\n' \
        "$operation" "$(read_config_value CHATBI_LOCAL_HTTP_PORT)" "$source_commit"
}

record_stopped_state() {
    local image_id="$1"
    if [[ ! "$image_id" =~ ^sha256:[0-9a-f]{64}$ && -f "$RELEASE_FILE" ]]; then
        local api_image
        api_image="$(awk -F= '$1 == "CHATBI_API_IMAGE" { print substr($0, index($0, "=") + 1) }' "$RELEASE_FILE")"
        image_id="$(docker image inspect --format '{{.Id}}' "$api_image" 2>/dev/null || true)"
    fi
    if [[ ! "$image_id" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        printf '服务已停止；没有可用本地 API 镜像更新部署状态记录。\n' >&2
        return 0
    fi
    if docker run --rm \
        --mount "type=bind,source=$ROOT/.local,target=/opt/chatbi-state" \
        --user "$(id -u):$(id -g)" \
        --entrypoint python "$image_id" -m scripts.local_release record-state \
        --event stopped --operation down --phase stopped --runtime-status stopped \
        >/dev/null 2>&1; then
        printf '本机部署状态记录已更新为 stopped。\n'
    else
        printf '服务已停止；部署状态文件未能更新，请以 ./local status 显示的容器状态为准。\n' >&2
    fi
}

main() {
    local command_name="${1:-help}"
    acquire_operation_lock "$command_name"
    shift || true
    case "$command_name" in
        help|-h|--help|build|build-operations) initialize_runtime_binding_defaults ;;
        *) resolve_runtime_binding ;;
    esac
    case "$command_name" in
        help|-h|--help)
            usage
            ;;
        init-config)
            initialize_config
            ;;
        build)
            build_images
            ;;
        build-operations)
            [[ -z "${1:-}" ]] || fail './local build-operations 不接受额外参数。'
            build_operations_image
            ;;
        init-backup|backup|backup-list)
            [[ -z "${1:-}" ]] || fail "./local $command_name 不接受额外参数。"
            require_docker
            require_config
            require_release
            [[ "$command_name" == backup-list ]] || prepare_operations_directories
            require_operations_image
            case "$command_name" in
                init-backup) compose run --rm -T --no-deps operations init --host-locked ;;
                backup)
                    verify_bound_existing_resources
                    run_manual_backup
                    ;;
                backup-list) compose run --rm -T --no-deps operations list ;;
            esac
            ;;
        down)
            [[ -z "${1:-}" ]] || fail './local down 不接受额外参数。'
            require_docker
            verify_bound_existing_resources
            local state_api_image_id='' fallback_api_image_id='' candidate_api_image_id state_api_container state_running
            while IFS= read -r state_api_container; do
                [[ -n "$state_api_container" ]] || continue
                candidate_api_image_id="$(docker inspect --format '{{.Image}}' "$state_api_container" 2>/dev/null || true)"
                [[ -n "$fallback_api_image_id" ]] || fallback_api_image_id="$candidate_api_image_id"
                state_running="$(docker inspect --format '{{.State.Running}}' "$state_api_container" 2>/dev/null || true)"
                if [[ "$state_running" == true ]]; then
                    state_api_image_id="$candidate_api_image_id"
                    break
                fi
            done < <(stable_container_ids api)
            [[ -n "$state_api_image_id" ]] || state_api_image_id="$fallback_api_image_id"
            stop_stable_services
            record_stopped_state "$state_api_image_id"
            ;;
        status)
            [[ -z "${1:-}" ]] || fail './local status 不接受额外参数。'
            require_docker
            verify_bound_existing_resources
            show_stable_status
            ;;
        logs)
            require_docker
            show_stable_logs "$@"
            ;;
        infra|migrate|create-admin|prepare-model|build-rag|up)
            require_config
            require_release
            require_docker
            prepare_host_directories
            check_compose_config
            verify_release_images
            case "$command_name" in
                infra)
                    start_infrastructure
                    ;;
                migrate)
                    start_infrastructure
                    compose run --rm -T migrator
                    ;;
                create-admin)
                    start_infrastructure
                    compose run --rm admin
                    ;;
                prepare-model)
                    compose run --rm -T model prepare-model
                    ;;
                build-rag)
                    start_infrastructure
                    local model_path
                    model_path="$(read_config_value CHATBI_LOCAL_MODEL_DIR)"
                    if [[ "$model_path" != /* ]]; then
                        model_path="$ROOT/$model_path"
                    fi
                    [[ -f "$model_path/config.json" ]] \
                        || fail '固定 revision 模型未准备；先运行 ./local prepare-model。'
                    compose run --rm -T model build-rag
                    ;;
                up)
                    [[ -z "${1:-}" ]] || fail './local up 不接受额外参数。'
                    ensure_local_api_port_available
                    local api_already_running=false
                    if capture_running_api_release; then
                        [[ "$RUNNING_SOURCE_COMMIT" == "$CHATBI_SOURCE_COMMIT" && "$RUNNING_API_IMAGE_ID" == "$CHATBI_API_IMAGE_ID" ]] \
                            || fail "稳定环境当前运行版本为 ${RUNNING_SOURCE_COMMIT}；请使用 ./local upgrade ${CHATBI_SOURCE_COMMIT} 切换版本。"
                        api_already_running=true
                    fi
                    if [[ "$api_already_running" == true ]]; then
                        start_infrastructure true
                    else
                        start_infrastructure
                    fi
                    compose run --rm -T --no-deps verify verify-runtime \
                        || fail '稳定环境前置检查未通过；按诊断完成显式初始化后重试。'
                    if [[ "$api_already_running" == true ]]; then
                        if ! stable_api_serves_configured_port "$(read_config_value CHATBI_LOCAL_HTTP_PORT)"; then
                            fail '稳定 API 仍在运行，但 HTTP liveness 或回环端口不再通过检查。'
                        fi
                        record_deployment_state begin up "$CHATBI_SOURCE_COMMIT" verifying-runtime running
                        if ! record_target_success up "$CHATBI_SOURCE_COMMIT"; then
                            fail '稳定 API 正在运行，但 active release 状态无法原子记录。'
                        fi
                        printf 'ChatBI 稳定环境已在运行：http://127.0.0.1:%s/\n版本：%s\n' \
                            "$(read_config_value CHATBI_LOCAL_HTTP_PORT)" "$CHATBI_SOURCE_COMMIT"
                    else
                        record_deployment_state begin up "$CHATBI_SOURCE_COMMIT" starting-api transitioning
                        run_target_api up "$CHATBI_SOURCE_COMMIT" starting-api
                        printf 'ChatBI 稳定环境已启动：http://127.0.0.1:%s/\n版本：%s\n' \
                            "$(read_config_value CHATBI_LOCAL_HTTP_PORT)" "$CHATBI_SOURCE_COMMIT"
                    fi
                    start_backup_scheduler
                    ;;
            esac
            ;;
        upgrade|rollback)
            (( $# == 1 )) || fail "用法：./local ${command_name} <完整40位source commit>"
            local target_commit="$1"
            select_release "$target_commit"
            upgrade_release "$command_name" "$CHATBI_SOURCE_COMMIT"
            ;;
        restore)
            (( $# == 1 )) || fail '用法：./local restore <已登记备份ID>'
            restore_backup "$1"
            ;;
        restore-activate)
            (( $# == 1 )) || fail '用法：./local restore-activate <已验证恢复ID>'
            restore_activate "$1"
            ;;
        restore-recover)
            (( $# == 2 )) || fail '用法：./local restore-recover <恢复ID> --previous|--candidate'
            case "$2" in
                --previous) restore_recover "$1" previous ;;
                --candidate) restore_recover "$1" candidate ;;
                *) fail '必须明确选择 --previous 或 --candidate。' ;;
            esac
            ;;
        *)
            usage >&2
            fail "未知命令：$command_name"
            ;;
    esac
}

cd "$ROOT"
main "$@"
