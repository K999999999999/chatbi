[
  {
    "metric_code": "sales_quantity",
    "metric_name": "销量",
    "metric_type": "atomic",
    "aliases": [
      "销售数量",
      "销售量",
      "卖出数量"
    ],
    "business_definition": "已完成销售订单的商品销售数量合计",
    "formula": "SUM(sales_orders.quantity)",
    "filters": [
      "sales_orders.order_status = 'completed'"
    ],
    "depends_on": [],
    "time_column": "sales_orders.order_date",
    "unit": "件"
  },
  {
    "metric_code": "sales_revenue",
    "metric_name": "销售额",
    "metric_type": "atomic",
    "aliases": [
      "销售收入",
      "营收"
    ],
    "business_definition": "已完成销售订单的不含税收入，按订单日期对应汇率统一折算为人民币",
    "formula": "SUM(sales_orders.net_amount * exchange_rates.rate_to_cny)",
    "filters": [
      "sales_orders.order_status = 'completed'"
    ],
    "depends_on": [],
    "time_column": "sales_orders.order_date",
    "unit": "CNY"
  },
  {
    "metric_code": "sales_cost",
    "metric_name": "销售成本",
    "metric_type": "atomic",
    "aliases": [
      "销售商品成本",
      "销售产品成本"
    ],
    "business_definition": "已完成销售订单对应产品的标准成本乘以销售数量；当前课程基线下标准成本按人民币口径使用",
    "formula": "SUM(dim_products.standard_cost * sales_orders.quantity)",
    "filters": [
      "sales_orders.order_status = 'completed'"
    ],
    "depends_on": [],
    "time_column": "sales_orders.order_date",
    "unit": "CNY"
  },
  {
    "metric_code": "gross_profit",
    "metric_name": "毛利",
    "metric_type": "derived",
    "aliases": [
      "销售毛利",
      "毛利润"
    ],
    "business_definition": "销售额扣除销售成本后的利润",
    "formula": "sales_revenue - sales_cost",
    "filters": [],
    "depends_on": [
      "sales_revenue",
      "sales_cost"
    ],
    "time_column": "sales_orders.order_date",
    "unit": "CNY"
  },
  {
    "metric_code": "gross_margin",
    "metric_name": "毛利率",
    "metric_type": "derived",
    "aliases": [
      "销售毛利率"
    ],
    "business_definition": "毛利占销售额的比例；销售额为零时该指标不计算",
    "formula": "gross_profit / sales_revenue",
    "filters": [],
    "depends_on": [
      "gross_profit",
      "sales_revenue"
    ],
    "time_column": "sales_orders.order_date",
    "unit": "percent"
  }
]
