[
  {
    "metric_code": "sales_quantity",
    "metric_name": "销量",
    "metric_type": "atomic",
    "aliases": [
      "销售数量",
      "销售量",
      "卖出数量"
    ],
    "business_definition": "已完成销售订单明细的销售数量合计。",
    "expression": "SUM(fct_sales_order_line.quantity)",
    "filters": [
      "fct_sales_order_line.order_status = 'completed'"
    ],
    "depends_on": [],
    "default_time_column_identity": "mart_sales.fct_sales_order_line.completion_date_key",
    "unit": "统一可聚合销售数量单位",
    "grain": "sales_order_line",
    "source_table": "fct_sales_order_line",
    "source_columns": [
      "quantity"
    ]
  },
  {
    "metric_code": "sales_revenue",
    "metric_name": "销售额",
    "metric_type": "atomic",
    "aliases": [
      "销售净额",
      "净销售额",
      "销售金额",
      "营收",
      "收入"
    ],
    "business_definition": "已完成销售的不含税净销售额，使用销售完成时已经冻结的人民币分析金额。",
    "expression": "SUM(fct_sales_order_line.net_sales_amount_cny)",
    "filters": [
      "fct_sales_order_line.order_status = 'completed'"
    ],
    "depends_on": [],
    "default_time_column_identity": "mart_sales.fct_sales_order_line.completion_date_key",
    "unit": "CNY",
    "grain": "sales_order_line",
    "source_table": "fct_sales_order_line",
    "source_columns": [
      "net_sales_amount_cny"
    ]
  },
  {
    "metric_code": "sales_cost",
    "metric_name": "销售成本",
    "metric_type": "atomic",
    "aliases": [
      "销售商品成本",
      "销售产品成本",
      "成本"
    ],
    "business_definition": "已完成销售对应的历史冻结销售成本。",
    "expression": "SUM(fct_sales_order_line.sales_cost_amount_cny)",
    "filters": [
      "fct_sales_order_line.order_status = 'completed'"
    ],
    "depends_on": [],
    "default_time_column_identity": "mart_sales.fct_sales_order_line.completion_date_key",
    "unit": "CNY",
    "grain": "sales_order_line",
    "source_table": "fct_sales_order_line",
    "source_columns": [
      "sales_cost_amount_cny"
    ]
  },
  {
    "metric_code": "gross_profit",
    "metric_name": "毛利",
    "metric_type": "derived",
    "aliases": [
      "销售毛利",
      "毛利润"
    ],
    "business_definition": "销售额减销售成本，反映销售订单明细层面的毛利。",
    "expression": "sales_revenue - sales_cost",
    "filters": [
      "fct_sales_order_line.order_status = 'completed'"
    ],
    "depends_on": [
      "sales_revenue",
      "sales_cost"
    ],
    "default_time_column_identity": "mart_sales.fct_sales_order_line.completion_date_key",
    "unit": "CNY",
    "grain": "sales_order_line"
  },
  {
    "metric_code": "gross_margin",
    "metric_name": "毛利率",
    "metric_type": "derived",
    "aliases": [
      "销售毛利率",
      "毛利润率"
    ],
    "business_definition": "毛利占销售额的比例；销售额为零时返回 NULL，表示不可计算。",
    "expression": "gross_profit / sales_revenue",
    "filters": [
      "fct_sales_order_line.order_status = 'completed'"
    ],
    "depends_on": [
      "gross_profit",
      "sales_revenue"
    ],
    "default_time_column_identity": "mart_sales.fct_sales_order_line.completion_date_key",
    "unit": "ratio",
    "grain": "sales_order_line",
    "null_if": "sales_revenue = 0"
  }
]
