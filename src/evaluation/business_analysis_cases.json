  "evaluation_rules": {
    "success": {
      "plan": {
        "judge": "逐个对照 expected_tasks 与实际任务，判断任务数量、用途、时期、指标和分析粒度是否匹配；允许描述不同但语义等价的任务。",
        "pass": "预期任务均被正确覆盖，且没有遗漏、错误任务或无关任务。"
      },
      "summary": {
        "reference": "使用本次成功执行的 Task 结果和程序归因作为事实依据；不在案例中固定数据库数值。",
        "judge": "判断总结是否说明实际变化方向和主要产品贡献，是否纠正与数据相反的问题前提，以及是否编造无证据的原因。",
        "pass": "关键事实与参考归因一致，回答了问题，且没有无依据的原因。"
      }
    },
    "clarification_required": {
      "plan": {
        "judge": "判断问题是否存在案例所描述的歧义或无效比较，并检查系统是否在查询前请求澄清且没有生成任务。",
        "pass": "返回 CLARIFICATION_REQUIRED，且任务数量为0。"
      },
      "task_results": "not_applicable",
      "summary": "not_applicable"
    },
    "cannot_answer": {
      "plan": {
        "judge": "判断问题是否明确落在当前经营分析不支持的指标或分析范围内；不应误当成指标歧义而请求澄清，也不应忽略限制后生成任务。",
        "pass": "返回 CANNOT_ANSWER，且任务数量为0。"
      },
      "task_results": "not_applicable",
      "summary": "not_applicable"
    }
  },
