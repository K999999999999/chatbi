    "schema_name": "mart_sales",
    "table_name": "fct_sales_order_line",
    "description": "一行代表一条销售订单明细。订单级数量必须按 order_id 去重，金额指标按明细金额汇总。"
  },
  "business_rules": [
    {
      "rule_id": "BR-001",
      "name": "已完成数据口径",
      "statement": "销售额、成本、毛利和毛利率默认只统计 order_status = completed 的订单明细。",
      "sql_condition": "f.order_status = 'completed'",
      "applies_to": [
        "net_sales_cny",
        "sales_cost_cny",
        "gross_profit_cny",
        "gross_margin"
      ]
    },
    {
      "rule_id": "BR-002",
      "name": "订单数量去重",
      "statement": "订单数量按订单业务标识 order_id 去重，不按订单明细行数计算。",
      "sql_expression": "COUNT(DISTINCT f.order_id)",
      "applies_to": [
        "completed_order_count"
      ]
    },
    {
      "rule_id": "BR-003",
      "name": "人民币金额字段",
      "statement": "人民币销售额和成本直接使用事实表已冻结的 CNY 金额字段，不重新连接汇率表计算。",
      "columns": [
        "fct_sales_order_line.net_sales_amount_cny",
        "fct_sales_order_line.sales_cost_amount_cny"
      ],
      "applies_to": [
        "net_sales_cny",
