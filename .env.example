# PostgreSQL database and Docker Compose
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=chatbi_mvp
POSTGRES_MIGRATOR_USER=chatbi_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_USER=chatbi_app
POSTGRES_APP_PASSWORD=

# ChatBI 应用库（与 chatbi_mvp 业务库分离）
POSTGRES_CONTROL_DB=chatbi_control
POSTGRES_CONTROL_APP_USER=chatbi_control_user
POSTGRES_CONTROL_APP_PASSWORD=
POSTGRES_CONTROL_MIGRATOR_USER=chatbi_migrator
POSTGRES_CONTROL_BOOTSTRAP_DB=postgres
CHATBI_ADMIN_SECRET_KEY=

# Query API Identity / Authorization（身份与数据授权）。仅用于本地 Demo/Test；生产环境不得使用。
CHATBI_ENV=development
CHATBI_IDENTITY_PROVIDER=test
CHATBI_IDENTITY_SUBJECT_ID=analyst-1
CHATBI_AUTH_POLICY_FILE=config/authorization-policy.example.json

# OpenAI-compatible LLM（大模型）配置。SQL 由 LLM 直接生成，不能绕过 SQL Guard。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=30

# Observability T1（可观测性 T1）。默认关闭；不填写 OTLP Header 或 Secret。
CHATBI_OBSERVABILITY_ENABLED=false
CHATBI_TRACE_CONTENT_ENABLED=false
CHATBI_RUNTIME_ENV=
OTEL_SERVICE_NAME=chatbi-engine
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
CHATBI_OTLP_TIMEOUT_SECONDS=5

# RAG Offline Build（离线构建）。仅写入 page_content 的向量和结构化 metadata。
RAG_OUTPUT_DIR=data/rag
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_PATH=
# 本地 Compose 和离线构建客户端共用；请生成随机值，不要提交真实密钥。
QDRANT_API_KEY=
RAG_QDRANT_TIMEOUT_SECONDS=30
RAG_COLLECTION_PREFIX=chatbi
RAG_MODEL_NAME_OR_PATH=BAAI/bge-m3
RAG_MODEL_DIR=models/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_USE_FP16=false
RAG_EMBEDDING_DEVICE=auto
