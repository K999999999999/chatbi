# PostgreSQL course baseline and Docker Compose
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=chatbi_mvp
POSTGRES_MIGRATOR_USER=chatbi_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_USER=chatbi_app
POSTGRES_APP_PASSWORD=

# Local Qdrant service consumed by offline index scripts
QDRANT_URL=http://127.0.0.1:6333

# Local BGE-M3 model consumed by offline index scripts
BGE_MODEL_DIR=models/bge-m3
BGE_USE_FP16=false
