# PostgreSQL 业务数据库和 Docker Compose。
# 当前默认开发方式：WSL/Linux 宿主机直接运行 ChatBI，
# PostgreSQL 通过 Docker Compose 暴露到宿主机 127.0.0.1:5433。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PUBLISHED_PORT=5433
POSTGRES_DB=chatbi_mvp

# 仅由一次性数据库初始化 / 迁移命令使用，不注入 API 运行进程。
POSTGRES_MIGRATOR_USER=chatbi_migrator
POSTGRES_MIGRATOR_PASSWORD=local-only-chatbi-migrator

# 业务查询运行时只读账号；只连接 chatbi_mvp。
POSTGRES_APP_USER=chatbi_app
POSTGRES_APP_PASSWORD=local-only-chatbi-app


# ChatBI 应用库（与 chatbi_mvp 分离）
POSTGRES_CONTROL_DB=chatbi_control

# 认证、Session、RBAC 和审计的运行时账号；只连接 chatbi_control。
POSTGRES_CONTROL_APP_USER=chatbi_control_user
POSTGRES_CONTROL_APP_PASSWORD=local-only-chatbi-control

# 通常复用上面的迁移账号；只用于初始化 / 迁移，不用于 API 运行。
POSTGRES_CONTROL_MIGRATOR_USER=chatbi_migrator
POSTGRES_CONTROL_BOOTSTRAP_DB=postgres

# 首次本地配置时生成随机值并只写入 .env；不要提交该值。
# WSL 可使用：openssl rand -hex 32
CHATBI_ADMIN_SECRET_KEY=


# Query API 运行模式。
# 真实入口使用 chatbi_control 内置账号，不读取静态身份配置。
CHATBI_ENV=development


# OpenAI-compatible LLM（大模型）配置。
# SQL 由 LLM 直接生成，不能绕过 SQL Guard。
# 当前使用 DeepSeek 官方 API。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30


# Observability T1（可观测性 T1）。
# 当前默认关闭，因此 OTLP Endpoint / Header 可以保持为空。
CHATBI_OBSERVABILITY_ENABLED=false
CHATBI_TRACE_CONTENT_ENABLED=false
CHATBI_RUNTIME_ENV=
OTEL_SERVICE_NAME=chatbi-engine
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
CHATBI_OTLP_TIMEOUT_SECONDS=5


# RAG Offline Build（离线构建）。
# 当前默认开发方式：WSL/Linux 宿主机运行构建命令，
# Qdrant 通过 Docker Compose 暴露到宿主机 127.0.0.1:6333。
RAG_OUTPUT_DIR=data/rag
RAG_QDRANT_URL=http://127.0.0.1:6333

# 使用远程/服务模式 Qdrant，因此本地 Path 保持为空。
RAG_QDRANT_PATH=

# 回环绑定开发服务使用的公开默认值；不要用于共享或生产环境。
QDRANT_API_KEY=local-only-chatbi-qdrant
RAG_QDRANT_TIMEOUT_SECONDS=30
RAG_COLLECTION_PREFIX=chatbi

# Embedding 模型
RAG_MODEL_NAME_OR_PATH=BAAI/bge-m3
RAG_MODEL_DIR=.model-cache/bge-m3-5617a9f61b02
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_USE_FP16=false
RAG_EMBEDDING_DEVICE=auto
